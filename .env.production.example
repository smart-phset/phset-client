# Copy OUTSIDE the checkout, chmod 600, edit privately. Compose >= 2.30 raw env_file.
# No quotes; one literal value per line. Never use NEXT_PUBLIC_ for these values.
AUTH_USER=team
AUTH_PASSWORD=REPLACE_WITH_UNIQUE_TEAM_PASSWORD
AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_HEX
ALLOW_GUEST=false
SMARTPHSET_API_BASE_URL=https://phset.api.ratanak.me
SMARTPHSET_IOT_API_KEY=REPLACE_WITH_EXISTING_PRIVATE_IOT_KEY
SMARTPHSET_DEVICE_ID=grow-room-1
# Until a separate secure AI relay has passed acceptance, keep BOTH false.
SMARTPHSET_AI_LIVE_ENABLED=false
SMARTPHSET_AI_CAMERA_ID=esp32-cam
SMARTPHSET_AI_LIVE_BASE_URL=
# Bearer credential enforced by the proposed private HTTPS relay, not ingestion key.
SMARTPHSET_AI_RELAY_TOKEN=
SMARTPHSET_AI_UPLOAD_ENABLED=false
BACKEND_MODE=bridge
BACKEND_URL=
API_KEY=

# New persistent camera routes are separate from legacy feature switches above.
# Leave disabled/unconfigured until private authenticated worker connectivity is accepted.
# The current runtime validator does not validate these three values.
SMARTPHSET_AI_SERVICE_URL=
SMARTPHSET_AI_SERVICE_KEY=
SMARTPHSET_CAMERA_API_KEY=
