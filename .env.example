# Copy to .env.local; replace YOUR_* placeholders privately before running.
# All these values are server-side; never prefix them with NEXT_PUBLIC_.
SMARTPHSET_API_BASE_URL=http://localhost:9090
SMARTPHSET_IOT_API_KEY=YOUR_PRIVATE_IOT_KEY
SMARTPHSET_DEVICE_ID=grow-room-1
# Legacy shared metadata ID; browser sessions receive their own random source IDs.
SMARTPHSET_AI_CAMERA_ID=esp32-cam
SMARTPHSET_AI_LIVE_BASE_URL=http://127.0.0.1:8001
# Local development. Production template disables shared AI until a secure relay exists.
SMARTPHSET_AI_LIVE_ENABLED=true
SMARTPHSET_AI_RELAY_TOKEN=
SMARTPHSET_AI_UPLOAD_ENABLED=true
AUTH_USER=team
AUTH_PASSWORD=YOUR_TEAM_PASSWORD
AUTH_SECRET=YOUR_PRIVATE_AUTH_SECRET
ALLOW_GUEST=true
# Optional real Upload Image service (bridge.py); blank URL gives demo uploads.
BACKEND_URL=
BACKEND_MODE=bridge
# Must match Python BRIDGE_API_KEY when BACKEND_URL is configured.
API_KEY=

# Persistent camera service; all server-only. Spring registry uses SMARTPHSET_API_BASE_URL above.
SMARTPHSET_AI_SERVICE_URL=http://127.0.0.1:8002
SMARTPHSET_AI_SERVICE_KEY=REPLACE_WITH_SAME_SECRET_AS_PYTHON
SMARTPHSET_CAMERA_API_KEY=REPLACE_WITH_SAME_SECRET_AS_SPRING
