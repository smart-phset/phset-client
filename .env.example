# Copy to .env.local for local runs, or set these in Vercel > Project > Settings > Environment Variables.
# BACKEND_URL settings below apply only to legacy prototype/bridge pages.
# Real Overview/Climate/History use the SMARTPHSET_* settings at the end.

# Laptop tunnel address, for example https://xyz.trycloudflare.com (no trailing slash)
BACKEND_URL=
# "api" = the engineer's Node REST API (docs/api-contract.md); "bridge" = bridge.py directly (AI only)
BACKEND_MODE=api
# Shared secret sent as "Authorization: Bearer <key>"; must match the laptop
API_KEY=

# Team login. Leave AUTH_PASSWORD empty = no team accounts yet (guests only).
AUTH_USER=team
AUTH_PASSWORD=
# Random string used to sign the login cookie
AUTH_SECRET=
# "false" turns off "Continue without an account" (guest access). Default: on.
ALLOW_GUEST=

# Phase 9 real Spring monitoring. All variables below are SERVER-ONLY.
# This dashboard never falls back to simulated data when Spring is unavailable.
SMARTPHSET_API_BASE_URL=http://localhost:9090
SMARTPHSET_IOT_API_KEY=
SMARTPHSET_DEVICE_ID=grow-room-1
# Match the camera_id used by the AI publisher: esp32-cam for a network stream,
# webcam-0 for local camera 0. Leave empty until the intended camera is known.
SMARTPHSET_AI_CAMERA_ID=
# Team login above is required for actuator control; guests are read-only.
