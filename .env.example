# Copy to .env.local; replace YOUR_* placeholders privately before running.
# All these values are server-side; never prefix them with NEXT_PUBLIC_.
SMARTPHSET_API_BASE_URL=http://localhost:9090
SMARTPHSET_IOT_API_KEY=YOUR_PRIVATE_IOT_KEY
SMARTPHSET_DEVICE_ID=grow-room-1
SMARTPHSET_AI_CAMERA_ID=webcam-0
SMARTPHSET_AI_LIVE_BASE_URL=http://127.0.0.1:8001
AUTH_USER=team
AUTH_PASSWORD=YOUR_TEAM_PASSWORD
AUTH_SECRET=YOUR_PRIVATE_AUTH_SECRET
ALLOW_GUEST=true
# Optional real Upload Image service (bridge.py); blank URL gives demo uploads.
BACKEND_URL=
BACKEND_MODE=bridge
# Must match Python BRIDGE_API_KEY when BACKEND_URL is configured.
API_KEY=
